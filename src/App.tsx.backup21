              <div className="grid grid-cols-2 gap-12">
                <div>
                  <p
                    className="text-sm text-[#444444] leading-[1.9]"
                    style={{ fontFamily: "var(--font-sans)", fontWeight: 300 }}
                  >
                    {/* Description of sports day goes here */}
                  </p>
                </div>
                <InterviewBlock question="체육대회에서 가장 기억에 남는 장면은?" />
              </div>
              <PageNum n="07" />
            </section>

            <div className="w-12 border-t border-[#D4D1CB] mx-16 my-4" />

            {/* 축제 */}
            <section id="festival" className="px-16 pb-20">
              <ChapterHeading number="II — 02" korean="축제" english="School Festival" />
              <div className="grid grid-cols-2 gap-8 mb-10">
                <PhotoSlot tall caption="무대 위에서" />
                <div className="flex flex-col gap-6">
                  <PhotoSlot caption="부스 활동" />
                  <PhotoSlot caption="관객석" />
                </div>
              </div>
              <InterviewBlock question="축제 때 가장 많이 웃었던 순간은?" />
              <PageNum n="08" />
            </section>

            <Divider />

            {/* ── 게스트북으로 이동 ──────────────────────────────── */}
            <div className="px-16 pb-24 flex justify-end">
              <button
                onClick={goToGuestbook}
                className="text-sm tracking-widest text-[#8A8A8A] hover:text-[#3A7AFE] transition-colors"
                style={{ fontFamily: "var(--font-sans)" }}
              >
                Guest Book →
              </button>
            </div>
            {/* ── COLOPHON ────────────────────────────────────────── */}
            <footer className="px-16 py-16 border-t border-[#D4D1CB] flex justify-between items-end">
              <div>
                <p
                  className="text-[10px] uppercase tracking-[0.3em] text-[#B5B0A8]"
                  style={{ fontFamily: "var(--font-sans)" }}
                >
                  EWOO MIDDLE SCHOOL
                </p>
                <p
                  className="text-[10px] text-[#C5C2BB] mt-1"
                  style={{ fontFamily: "var(--font-sans)" }}
                >
                  22nd ARCHIVE · 2024 — 2026
                </p>
              </div>
              <p
                className="text-[10px] text-[#C5C2BB]"
                style={{ fontFamily: "var(--font-sans)" }}
              >
                다정함으로 바라본 우리 학교
              </p>
            </footer>
          </div>
        </div>
      )}

      {/* ── GUEST BOOK PAGE ───────────────────────────────────── */}
      {view === "guestbook" && (
        <div
          className="bg-[#F7F7F4] min-h-screen"
          style={{ animation: "fadeIn 0.6s ease both" }}
        >
          <style>{`
            @keyframes fadeIn {
              from { opacity: 0; transform: translateY(12px); }
              to   { opacity: 1; transform: translateY(0); }
            }
          `}</style>

          <TopNav onNavClick={handleNav} onLogoClick={goToCover} />

          <GuestBook />

          <div className="px-16 pb-24">
            <button
              onClick={() => {
                setView("records");
                setTimeout(() => {
                  document.getElementById("festival")?.scrollIntoView({ behavior: "smooth" });
                }, 400);
              }}
              className="text-sm tracking-widest text-[#8A8A8A] hover:text-[#3A7AFE] transition-colors"
              style={{ fontFamily: "var(--font-sans)" }}
            >
              ← 기록으로 돌아가기
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
